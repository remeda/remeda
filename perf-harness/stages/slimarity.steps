# Stage "slimarity": lazyDataLastImpl on the final branch slimmed to a
# dedicated data-last closure for exactly one stored argument (slim1) or for
# none and one (slim01), the spread for every other count; direct lazy/lazyArgs
# writes kept (variants/slim1.patch, variants/slim01.patch).
# Hand-written (2026-10-09), not generated by make-stage.mjs.
# 13 steps, estimated 43 min of measurement (plus the watcher's idle waits);
# the longest step is about 4.4 min.
# Start it with: printf 'sha=%s\nsteps=stages/slimarity.steps\n' 2fab5832528d2a9103dbd635d4c4cc9f0826e723 > markers/READY-slimarity
#
# Copies: main, main-aa, branch (2fab5832), branch-v-slim1 and branch-v-slim01,
# always listed as main,branch,main-aa,branch-v-slim1,branch-v-slim01: in that
# order, rotations 0 and 2 put each slim copy before and after both main and
# the branch, and main-aa before and after main. noarity is prepared (for the
# bundle step) but not measured; the verdict reads its numbers from
# results/noarity.
# Every measuring step is resumable (--if-missing); the last step writes
# results/slimarity/verdict.md (scripts/slimarity-verdict.mjs).

## Prepare (snapshots, the slim1 / slim01 / noarity copies, dists, validation)
# ~1 min (seconds when libs/ is already at this state)
node scripts/prepare.mjs --sha "$PERF_SHA" --variants variants/slimarity.json

## Bundle size, main / branch / slim1 / slim01 / noarity (deterministic;
## written when the stage was staged, so normally skipped)
# ~1 s
node scripts/bundle-size.mjs --name slimarity/bundle --copies main,branch,branch-v-slim1,branch-v-slim01,branch-v-noarity --if-missing

## Confirmation: rotations 0-5 (k mod 5 = 0,1,2,3,4,0), noarity's targets
## (G3 incl. x64/x1; G6, G7 data-last and G10 at XS/S/C) plus the T1G guard,
## scale 0.5, no native
# ~3.9 min, 136 entries
node scripts/run-bench.mjs --name slimarity/conf-r0 --copies main,branch,main-aa,branch-v-slim1,branch-v-slim01 --rotation 0 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets slim1,slim01 --scale 0.5 --no-native --if-missing
# ~3.9 min, 136 entries
node scripts/run-bench.mjs --name slimarity/conf-r1 --copies main,branch,main-aa,branch-v-slim1,branch-v-slim01 --rotation 1 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets slim1,slim01 --scale 0.5 --no-native --if-missing
# ~3.9 min, 136 entries
node scripts/run-bench.mjs --name slimarity/conf-r2 --copies main,branch,main-aa,branch-v-slim1,branch-v-slim01 --rotation 2 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets slim1,slim01 --scale 0.5 --no-native --if-missing
# ~3.9 min, 136 entries
node scripts/run-bench.mjs --name slimarity/conf-r3 --copies main,branch,main-aa,branch-v-slim1,branch-v-slim01 --rotation 3 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets slim1,slim01 --scale 0.5 --no-native --if-missing
# ~3.9 min, 136 entries
node scripts/run-bench.mjs --name slimarity/conf-r4 --copies main,branch,main-aa,branch-v-slim1,branch-v-slim01 --rotation 4 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets slim1,slim01 --scale 0.5 --no-native --if-missing
# ~3.9 min, 136 entries
node scripts/run-bench.mjs --name slimarity/conf-r5 --copies main,branch,main-aa,branch-v-slim1,branch-v-slim01 --rotation 5 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets slim1,slim01 --scale 0.5 --no-native --if-missing

## Lower JIT tiers: the data-last scenarios (G3, G6, G7 data-last) at
## XS/S/C/x64/x1, 2 runs each in rotations 0 and 2, scale 1 (as noarity's),
## no native
# ~4.4 min, 82 entries
node scripts/run-bench.mjs --name slimarity/jitless-r0 --copies main,branch,main-aa,branch-v-slim1,branch-v-slim01 --rotation 0 --groups G3,G6,G7 --ids '^(?!.*data-first)' --sizes XS,S,C,x64,x1 --source dist --node-flags=--jitless --scale 1 --no-native --if-missing
# ~4.4 min, 82 entries
node scripts/run-bench.mjs --name slimarity/jitless-r2 --copies main,branch,main-aa,branch-v-slim1,branch-v-slim01 --rotation 2 --groups G3,G6,G7 --ids '^(?!.*data-first)' --sizes XS,S,C,x64,x1 --source dist --node-flags=--jitless --scale 1 --no-native --if-missing
# ~4.4 min, 82 entries
node scripts/run-bench.mjs --name slimarity/maxopt1-r0 --copies main,branch,main-aa,branch-v-slim1,branch-v-slim01 --rotation 0 --groups G3,G6,G7 --ids '^(?!.*data-first)' --sizes XS,S,C,x64,x1 --source dist --max-opt 1 --scale 1 --no-native --if-missing
# ~4.4 min, 82 entries
node scripts/run-bench.mjs --name slimarity/maxopt1-r2 --copies main,branch,main-aa,branch-v-slim1,branch-v-slim01 --rotation 2 --groups G3,G6,G7 --ids '^(?!.*data-first)' --sizes XS,S,C,x64,x1 --source dist --max-opt 1 --scale 1 --no-native --if-missing

## Reports (no measurement): the aggregations, then the verdict
## (results/slimarity/verdict.md)
# ~1 min
node scripts/aggregate.mjs --allow-empty --out results/slimarity/agg-conf --title 'slimarity confirmation (vs main; slim vs branch in verdict.md)' --candidates branch,branch-v-slim1,branch-v-slim01 results/slimarity/conf-r*.json && node scripts/aggregate.mjs --allow-empty --out results/slimarity/agg-jitless --title 'slimarity, --jitless' --candidates branch,branch-v-slim1,branch-v-slim01 results/slimarity/jitless-r*.json && node scripts/aggregate.mjs --allow-empty --out results/slimarity/agg-maxopt1 --title 'slimarity, --max-opt=1' --candidates branch,branch-v-slim1,branch-v-slim01 results/slimarity/maxopt1-r*.json && node scripts/slimarity-verdict.mjs --dir results/slimarity --noarity-dir results/noarity

# Stage "datafirst": plain eager data-first implementations for the 8
# utilities that only had lazy code (unique, uniqueBy, uniqueWith, difference,
# differenceWith, intersection, intersectionWith, mapWithFeedback), moved from
# purryFromLazy to purryWithLazy with their lazy implementations unchanged;
# purryFromLazy deleted (variant `datafirst`: variants/datafirst.patch, copy
# branch-v-datafirst).
# Hand-written (2026-10-10), not generated by make-stage.mjs.
# 9 steps, estimated 26 min of measurement (plus the watcher's idle waits);
# the longest step is about 4.0 min.
# Start it with: printf 'sha=%s\nsteps=stages/datafirst.steps\n' 3065f5bedca381851f24e8f62faf1262b2f935e3 > markers/READY-datafirst
#
# Copies: main, main-aa, branch (3065f5be) and branch-v-datafirst, always
# listed as main,branch,main-aa,branch-v-datafirst: rotations 0-5 (k mod 4 =
# 0,1,2,3,0,1) put the new copy before and after both main and the branch, and
# main-aa before and after main.
# Every measuring step is resumable (--if-missing); the last step writes
# results/datafirst/verdict.md (scripts/datafirst-verdict.mjs).

## Prepare (snapshots, the datafirst copy, dists, validation)
# ~0.5 min (seconds when libs/ is already at this state)
node scripts/prepare.mjs --sha "$PERF_SHA" --variants variants/datafirst.json

## Bundle size, main / branch / datafirst, the data-first import sets
## (deterministic; written when the stage was staged, so normally skipped)
# ~5 s
node scripts/bundle-size.mjs --name datafirst/bundle --copies main,branch,branch-v-datafirst --set datafirst --if-missing

## Confirmation: 6 cyclic rotations, the datafirst targets (the 8 functions'
## G5 data-first scenarios and G1b pipe scenarios at XS/S/C/M; G5 defines no
## Mx64 for them) plus the T1G guard, scale 0.5, no native
# ~4.0 min, 173 entries
node scripts/run-bench.mjs --name datafirst/conf-r0 --copies main,branch,main-aa,branch-v-datafirst --rotation 0 --source dist --guard T1G --targets datafirst --scale 0.5 --no-native --if-missing
# ~4.0 min, 173 entries
node scripts/run-bench.mjs --name datafirst/conf-r1 --copies main,branch,main-aa,branch-v-datafirst --rotation 1 --source dist --guard T1G --targets datafirst --scale 0.5 --no-native --if-missing
# ~4.0 min, 173 entries
node scripts/run-bench.mjs --name datafirst/conf-r2 --copies main,branch,main-aa,branch-v-datafirst --rotation 2 --source dist --guard T1G --targets datafirst --scale 0.5 --no-native --if-missing
# ~4.0 min, 173 entries
node scripts/run-bench.mjs --name datafirst/conf-r3 --copies main,branch,main-aa,branch-v-datafirst --rotation 3 --source dist --guard T1G --targets datafirst --scale 0.5 --no-native --if-missing
# ~4.0 min, 173 entries
node scripts/run-bench.mjs --name datafirst/conf-r4 --copies main,branch,main-aa,branch-v-datafirst --rotation 4 --source dist --guard T1G --targets datafirst --scale 0.5 --no-native --if-missing
# ~4.0 min, 173 entries
node scripts/run-bench.mjs --name datafirst/conf-r5 --copies main,branch,main-aa,branch-v-datafirst --rotation 5 --source dist --guard T1G --targets datafirst --scale 0.5 --no-native --if-missing

## Reports (no measurement): the aggregation, then the verdict
## (results/datafirst/verdict.md)
# ~1 min
node scripts/aggregate.mjs --allow-empty --out results/datafirst/agg-conf --title 'datafirst confirmation (vs main; new vs branch in verdict.md)' --candidates branch,branch-v-datafirst results/datafirst/conf-r*.json && node scripts/datafirst-verdict.mjs --dir results/datafirst

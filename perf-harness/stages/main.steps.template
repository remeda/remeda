# Stage "main": everything needed to decide the PR's design.
#
# Expand with `node scripts/make-stage.mjs main` (writes stages/main.steps and
# prints the estimate), then start it with
#   printf 'sha=%s\nsteps=stages/main.steps\n' <sha> > markers/READY-main
# Directives (lines starting with @) are documented in scripts/make-stage.mjs.
# Every measuring step is resumable (--if-missing): a rerun after a failure
# skips what already finished.
#
# Order: the core picture first, so that a stage cut short still answers the
# main questions: prepare, the full matrix (2 rotations), the combination copy
# of the screened survivors (variants/combo.patch, prepared up front by the
# first step; tiers 1 and 2), the extras and their reports, and only then the
# variant confirmation: every survivor in variants/survivors.json `order`
# (design candidates first, the clear wins in screening order, the borderline
# survivors last) in batches of 3 next to main/branch/main-aa, rotations 0-5,
# scale 0.5, on the batch's targets plus the tier 1 guard T1G (tier 1 at
# XS/x64/x1 and the tier 1 headline entries), all at XS/S/C/x64/x1.
#
# Subsets: the runtime and JIT-tier extras run HD (the headline subset plus
# every tier 1 data-first entry) instead of the full tier 1 subset, the
# pollution profiles G1/G2/G10 at C and M, the loaders the headline subset H.

## Prepare (snapshots, the screened survivors, the combination copy, dists, validation)
@prepare --variants variants/survivors.json --combo-patch variants/combo.patch

## Full matrix, 2 rotations (main / branch / main-aa + native)
@bench full rotations=0,1 --source dist

## Combination of the screened survivors (variants/combo.patch), 2 rotations, tiers 1 and 2
@bench combo rotations=0,1 copies=main,branch,main-aa,branch-v-combo --tiers 1,2 --skip-unless-copy branch-v-combo --source dist --no-native

## Extras: lower JIT tiers (HD)
@bench x-jitless rotations=0,1 --subset HD --source dist --no-native --node-flags=--jitless
@bench x-maxopt1 rotations=0,1 --subset HD --source dist --no-native --max-opt 1
@bench x-maxopt2 rotations=0,1 --subset HD --source dist --no-native --max-opt 2

## Extras: pollution profiles, G1/G2/G10 at C and M (P2 is the default everywhere else)
@bench x-p0 rotations=0,1 --groups G1,G2,G10 --sizes C,M --source dist --no-native --pollution P0
@bench x-p1 rotations=0,1 --groups G1,G2,G10 --sizes C,M --source dist --no-native --pollution P1

## Extras: Node 22 and 24 (HD)
@bench x-node22 rotations=0,1 --subset HD --source dist --no-native --node runtimes/node22/node_modules/.bin/node
@bench x-node24 rotations=0,1 --subset HD --source dist --no-native --node runtimes/node24/node_modules/.bin/node

## Extras: loaders, headline subset (one scope-hoisted bundle, CJS)
@bench x-bundle rotations=0,1 --subset H --source bundle --no-native
@bench x-cjs rotations=0,1 --subset H --source cjs --no-native

## Extras: the vitest-free runner under Bun and Node (HD), one copy per process (headline)
@portable x-bun runtime=bun rotations=0,1 --subset HD --no-native
@portable x-portable-node runtime=node rotations=0,1 --subset HD --no-native
@portable x-isolated runtime=node rotations=0,1 --subset H --per-process

## Extras: allocation, peak heap, bundle size, cold start, reactive stores
@once 6 node scripts/alloc.mjs --name {stage}/alloc --if-missing && node --expose-gc scripts/peak-heap.mjs --name {stage}/peak --if-missing && node scripts/bundle-size.mjs --name {stage}/bundle --if-missing && node scripts/cold.mjs --name {stage}/cold --if-missing && node scripts/reactive.mjs --name {stage}/reactive --if-missing

## Reports for everything above (no measurement; the trap counts come from prepare's validation)
@aggregate agg-full full-r* --title "Full matrix (dist)" --validate results/validate-dist.json
@aggregate agg-combo combo-r* --title "Combination of the screened survivors (variants/combo.patch)"
@aggregate agg-x-jitless x-jitless-r* --title "Interpreter only (--jitless)"
@aggregate agg-x-maxopt1 x-maxopt1-r* --title "Sparkplug ceiling (--max-opt=1)"
@aggregate agg-x-maxopt2 x-maxopt2-r* --title "Maglev ceiling (--max-opt=2)"
@aggregate agg-x-p0 x-p0-r* --title "No pollution (P0)"
@aggregate agg-x-p1 x-p1-r* --title "Map/filter/find/take over 10 item shapes (P1)"
@aggregate agg-x-node22 x-node22-r* --title "Node 22"
@aggregate agg-x-node24 x-node24-r* --title "Node 24"
@aggregate agg-x-bundle x-bundle-r* --title "Scope-hoisted bundle"
@aggregate agg-x-cjs x-cjs-r* --title "CJS through require"
@aggregate agg-x-bun x-bun-r* --title "Bun (portable runner)"
@aggregate agg-x-portable-node x-portable-node-r* --title "Node (portable runner)"
@aggregate agg-x-isolated x-isolated-r* --title "One copy per process (headline)"

## Variant confirmation, last (batches of 3 survivors in variants/survivors.json `order`: the design candidates, then the clear wins, the borderline ones last; next to main/branch/main-aa, 6 rotations, tier 1 guard T1G + targets)
@variants vb batch=3 scale=0.5 survivors=variants/survivors.json guard=T1G rotations=0,1,2,3,4,5 --source dist --sizes XS,S,C,x64,x1

## Variant report (no measurement)
@aggregate variants vb-* --title "Variant confirmation" --survivors-out results/{stage}/survivors.json

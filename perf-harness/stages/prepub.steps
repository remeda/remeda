# Stage "prepub": pre-publication confirmation of the design-B candidates.
# Hand-written by A8 (2026-10-08), not generated by make-stage.mjs.
# 13 steps, estimated 1.2 h of measurement (plus the watcher's idle waits);
# the longest step is about 8 min.
# Start it with: printf 'sha=%s\nsteps=stages/prepub.steps\n' 144fdc8b6208b40b7fc1f0690ecc99dd17c2a5a6 > markers/READY-prepub
#
# Copies: main, main-aa and the four candidates of variants/prepub.json
# (variants/index.json, all protocol "own"):
#   cand-base   identity-controls-v2 + pipe-single-step-runs + pipe-isarray-first
#               + datalast-direct-props + unique-single-lookup + sentinel-module
#               + requiredata-direct-write + datalast-arity-closures, iteration
#               as on the branch
#   cand-map    cand-base + the map shortcut (callback as evaluator)
#   cand-forof  cand-base + the array-only for...of rework
#   cand-full   cand-base + both
# Every measuring step is resumable (--if-missing); the reports at the end
# decide the composition (results/prepub/verdicts.md).

## Prepare (snapshots, the four candidates, dists, validation)
# ~1-4 min
node scripts/prepare.mjs --sha "$PERF_SHA" --variants variants/prepub.json

## Confirmation: 6 cyclic rotations (every copy in every position once), the
## targets of cand-map and cand-forof plus the T1G guard, XS/S/C/x64/x1,
## scale 0.5, no native (variant rule: cand-map and cand-forof vs cand-base)
# ~8.1 min, 239 entries
node scripts/run-bench.mjs --name prepub/conf-r0 --copies main,main-aa,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --rotation 0 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets cand-map,cand-forof --scale 0.5 --no-native --if-missing
# ~8.1 min, 239 entries
node scripts/run-bench.mjs --name prepub/conf-r1 --copies main,main-aa,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --rotation 1 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets cand-map,cand-forof --scale 0.5 --no-native --if-missing
# ~8.1 min, 239 entries
node scripts/run-bench.mjs --name prepub/conf-r2 --copies main,main-aa,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --rotation 2 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets cand-map,cand-forof --scale 0.5 --no-native --if-missing
# ~8.1 min, 239 entries
node scripts/run-bench.mjs --name prepub/conf-r3 --copies main,main-aa,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --rotation 3 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets cand-map,cand-forof --scale 0.5 --no-native --if-missing
# ~8.1 min, 239 entries
node scripts/run-bench.mjs --name prepub/conf-r4 --copies main,main-aa,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --rotation 4 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets cand-map,cand-forof --scale 0.5 --no-native --if-missing
# ~8.1 min, 239 entries
node scripts/run-bench.mjs --name prepub/conf-r5 --copies main,main-aa,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --rotation 5 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets cand-map,cand-forof --scale 0.5 --no-native --if-missing

## Reactive-store probes (Vue, MobX), Vue dependencies per pipe shape, Proxy-trap counts, every copy
# ~1 min
node scripts/reactive.mjs --name prepub/reactive --copies main,main-aa,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --runs 3 --if-missing && node scripts/vue-shapes.mjs --name prepub/vue-shapes --copies main,main-aa,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --if-missing && node --expose-gc scripts/validate.mjs --source dist --copies main,main-aa,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --groups G8 --ids Proxy --quiet --out results/prepub/traps.json

## cand-full vs main where the branch broke a tier bar, 2 runs each (rotations 0 and 1 of main / cand-full / main-aa)
# ~2.6 min, 4 runs of 18 entries: pollution P0 and P1, G2 and G10 at C and M
node scripts/run-bench.mjs --name prepub/x-p0-r0 --copies main,branch-v-cand-full,main-aa --rotation 0 --groups G2,G10 --sizes C,M --source dist --pollution P0 --no-native --if-missing && node scripts/run-bench.mjs --name prepub/x-p0-r1 --copies main,branch-v-cand-full,main-aa --rotation 1 --groups G2,G10 --sizes C,M --source dist --pollution P0 --no-native --if-missing && node scripts/run-bench.mjs --name prepub/x-p1-r0 --copies main,branch-v-cand-full,main-aa --rotation 0 --groups G2,G10 --sizes C,M --source dist --pollution P1 --no-native --if-missing && node scripts/run-bench.mjs --name prepub/x-p1-r1 --copies main,branch-v-cand-full,main-aa --rotation 1 --groups G2,G10 --sizes C,M --source dist --pollution P1 --no-native --if-missing
# ~4.4 min, 2 runs of 64 entries: Node 24, HD
node scripts/run-bench.mjs --name prepub/x-node24-r0 --copies main,branch-v-cand-full,main-aa --rotation 0 --subset HD --source dist --node runtimes/node24/node_modules/.bin/node --no-native --if-missing && node scripts/run-bench.mjs --name prepub/x-node24-r1 --copies main,branch-v-cand-full,main-aa --rotation 1 --subset HD --source dist --node runtimes/node24/node_modules/.bin/node --no-native --if-missing
# ~4.0 min, 2 runs of 64 entries: Bun (portable runner), HD; then one copy per process, H (~2 min, 2 runs of 23 entries)
runtimes/bun/node_modules/.bin/bun scripts/run-portable.mjs --name prepub/x-bun-r0 --copies main,branch-v-cand-full,main-aa --rotation 0 --subset HD --no-native --if-missing && runtimes/bun/node_modules/.bin/bun scripts/run-portable.mjs --name prepub/x-bun-r1 --copies main,branch-v-cand-full,main-aa --rotation 1 --subset HD --no-native --if-missing && node --expose-gc scripts/run-portable.mjs --name prepub/x-isolated-r0 --copies main,branch-v-cand-full,main-aa --rotation 0 --subset H --per-process --if-missing && node --expose-gc scripts/run-portable.mjs --name prepub/x-isolated-r1 --copies main,branch-v-cand-full,main-aa --rotation 1 --subset H --per-process --if-missing

## Allocations and bundle size, every copy
# ~6 min
node scripts/alloc.mjs --name prepub/alloc --copies main,main-aa,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --if-missing && node scripts/bundle-size.mjs --name prepub/bundle --copies main,branch-v-cand-base,branch-v-cand-map,branch-v-cand-forof,branch-v-cand-full --if-missing

## Reports (no measurement): aggregations, then the rule verdicts and the final composition (results/prepub/verdicts.md)
# ~1 min
node scripts/aggregate.mjs --allow-empty --out results/prepub/agg-conf --title 'Pre-publication confirmation (candidates vs main; rule verdicts in verdicts.md)' results/prepub/conf-r*.json && node scripts/aggregate.mjs --allow-empty --out results/prepub/agg-x-p0 --title 'cand-full vs main, P0' results/prepub/x-p0-r*.json && node scripts/aggregate.mjs --allow-empty --out results/prepub/agg-x-p1 --title 'cand-full vs main, P1' results/prepub/x-p1-r*.json && node scripts/aggregate.mjs --allow-empty --out results/prepub/agg-x-node24 --title 'cand-full vs main, Node 24' results/prepub/x-node24-r*.json && node scripts/aggregate.mjs --allow-empty --out results/prepub/agg-x-bun --title 'cand-full vs main, Bun' results/prepub/x-bun-r*.json && node scripts/aggregate.mjs --allow-empty --out results/prepub/agg-x-isolated --title 'cand-full vs main, one copy per process' results/prepub/x-isolated-r*.json && node scripts/prepub-verdicts.mjs --dir results/prepub

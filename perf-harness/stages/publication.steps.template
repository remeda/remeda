# Stage "publication": the numbers that go into the PR. Six rotations of the
# full matrix (every copy in every position twice; native in the two
# rotation-0 runs), then every extra at two runs per order (rotations 0 and 1,
# twice each: main before branch, and branch before main).
#
# Subset policy (as in stage main, budget about 5 h): the runtime extras run
# on the tier 1 subset T1, the JIT-tier extras on T1 too, the pollution
# profiles G1/G2/G10 at C and M, the loaders the headline subset H. No variant
# copies are prepared (--no-variants): main and the branch only.
#
# Expand with `node scripts/make-stage.mjs publication`, then start it with
#   printf 'sha=%s\nsteps=stages/publication.steps\n' <sha> > markers/READY-publication
# Directives (lines starting with @) are documented in scripts/make-stage.mjs.

## Prepare (snapshots, dists, validation; no variants)
@prepare --no-variants

## Full matrix, 6 rotations (main / branch / main-aa; native in the two rotation-0 runs)
@bench full rotations=all*2 native=0 --source dist

## Extras: lower JIT tiers (T1)
@bench x-jitless rotations=0,1*2 --subset T1 --source dist --no-native --node-flags=--jitless
@bench x-maxopt1 rotations=0,1*2 --subset T1 --source dist --no-native --max-opt 1
@bench x-maxopt2 rotations=0,1*2 --subset T1 --source dist --no-native --max-opt 2

## Extras: pollution profiles, G1/G2/G10 at C and M (P2 is the default everywhere else)
@bench x-p0 rotations=0,1*2 --groups G1,G2,G10 --sizes C,M --source dist --no-native --pollution P0
@bench x-p1 rotations=0,1*2 --groups G1,G2,G10 --sizes C,M --source dist --no-native --pollution P1

## Extras: Node 22 and 24 (T1)
@bench x-node22 rotations=0,1*2 --subset T1 --source dist --no-native --node runtimes/node22/node_modules/.bin/node
@bench x-node24 rotations=0,1*2 --subset T1 --source dist --no-native --node runtimes/node24/node_modules/.bin/node

## Extras: loaders, headline subset (one scope-hoisted bundle, CJS)
@bench x-bundle rotations=0,1*2 --subset H --source bundle --no-native
@bench x-cjs rotations=0,1*2 --subset H --source cjs --no-native

## Extras: the vitest-free runner under Bun and Node (T1), one copy per process (headline)
@portable x-bun runtime=bun rotations=0,1*2 --subset T1 --no-native
@portable x-portable-node runtime=node rotations=0,1*2 --subset T1 --no-native
@portable x-isolated runtime=node rotations=0,1*2 --subset H --per-process

## Extras: allocation, peak heap, bundle size, cold start, reactive stores
@once 8 node scripts/alloc.mjs --name {stage}/alloc --if-missing && node --expose-gc scripts/peak-heap.mjs --name {stage}/peak --if-missing && node scripts/bundle-size.mjs --name {stage}/bundle --if-missing && node scripts/cold.mjs --name {stage}/cold --runs 40 --if-missing && node scripts/reactive.mjs --name {stage}/reactive --runs 5 --if-missing

## Reports (no measurement; the trap counts come from prepare's validation)
@aggregate agg-full full-r* --title "Full matrix (dist), 6 rotations" --validate results/validate-dist.json
@aggregate agg-x-jitless x-jitless-r* --title "Interpreter only (--jitless)"
@aggregate agg-x-maxopt1 x-maxopt1-r* --title "Sparkplug ceiling (--max-opt=1)"
@aggregate agg-x-maxopt2 x-maxopt2-r* --title "Maglev ceiling (--max-opt=2)"
@aggregate agg-x-p0 x-p0-r* --title "No pollution (P0)"
@aggregate agg-x-p1 x-p1-r* --title "Map/filter/find/take over 10 item shapes (P1)"
@aggregate agg-x-node22 x-node22-r* --title "Node 22"
@aggregate agg-x-node24 x-node24-r* --title "Node 24"
@aggregate agg-x-bundle x-bundle-r* --title "Scope-hoisted bundle"
@aggregate agg-x-cjs x-cjs-r* --title "CJS through require"
@aggregate agg-x-bun x-bun-r* --title "Bun (portable runner)"
@aggregate agg-x-portable-node x-portable-node-r* --title "Node (portable runner)"
@aggregate agg-x-isolated x-isolated-r* --title "One copy per process (headline)"

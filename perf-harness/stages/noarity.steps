# Stage "noarity": lazyDataLastImpl's per-arity data-last closures (commit
# a0e9ffff) reverted to main's single `(data) => fn(data, ...args)` closure on
# the final branch, the direct lazy/lazyArgs writes kept (variant `noarity`:
# variants/noarity.patch, copy branch-v-noarity).
# Hand-written (2026-10-09), not generated by make-stage.mjs.
# 13 steps, estimated 36 min of measurement (plus the watcher's idle waits);
# the longest step is about 3.5 min.
# Start it with: printf 'sha=%s\nsteps=stages/noarity.steps\n' 2fab5832528d2a9103dbd635d4c4cc9f0826e723 > markers/READY-noarity
#
# Copies: main, main-aa, branch (2fab5832) and branch-v-noarity, always listed
# as main,branch,main-aa,branch-v-noarity: in that order, rotations 0 and 2
# put noarity before and after both main and the branch, and main-aa before
# and after main.
# Every measuring step is resumable (--if-missing); the last step writes
# results/noarity/verdict.md (scripts/noarity-verdict.mjs).

## Prepare (snapshots, the noarity copy, dists, validation)
# ~1 min (seconds when libs/ is already at this state)
node scripts/prepare.mjs --sha "$PERF_SHA" --variants variants/noarity.json

## Bundle size, main / branch / noarity (deterministic; written when the stage
## was staged, so normally skipped)
# ~1 s
node scripts/bundle-size.mjs --name noarity/bundle --copies main,branch,branch-v-noarity --if-missing

## Confirmation: 6 cyclic rotations (k mod 4 = 0,1,2,3,0,1), the noarity
## targets (G3 incl. x64/x1; G6, G7 data-last and G10 at XS/S/C; includes
## clamp data-last C) plus the T1G guard, scale 0.5, no native
# ~3.2 min, 136 entries
node scripts/run-bench.mjs --name noarity/conf-r0 --copies main,branch,main-aa,branch-v-noarity --rotation 0 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets noarity --scale 0.5 --no-native --if-missing
# ~3.2 min, 136 entries
node scripts/run-bench.mjs --name noarity/conf-r1 --copies main,branch,main-aa,branch-v-noarity --rotation 1 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets noarity --scale 0.5 --no-native --if-missing
# ~3.2 min, 136 entries
node scripts/run-bench.mjs --name noarity/conf-r2 --copies main,branch,main-aa,branch-v-noarity --rotation 2 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets noarity --scale 0.5 --no-native --if-missing
# ~3.2 min, 136 entries
node scripts/run-bench.mjs --name noarity/conf-r3 --copies main,branch,main-aa,branch-v-noarity --rotation 3 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets noarity --scale 0.5 --no-native --if-missing
# ~3.2 min, 136 entries
node scripts/run-bench.mjs --name noarity/conf-r4 --copies main,branch,main-aa,branch-v-noarity --rotation 4 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets noarity --scale 0.5 --no-native --if-missing
# ~3.2 min, 136 entries
node scripts/run-bench.mjs --name noarity/conf-r5 --copies main,branch,main-aa,branch-v-noarity --rotation 5 --sizes XS,S,C,x64,x1 --source dist --guard T1G --targets noarity --scale 0.5 --no-native --if-missing

## Lower JIT tiers: the data-last scenarios (G3, G6, G7 data-last) at
## XS/S/C/x64/x1, 2 runs each in rotations 0 and 2, scale 1 (as the
## publication stage's lower-tier runs), no native
# ~3.5 min, 82 entries
node scripts/run-bench.mjs --name noarity/jitless-r0 --copies main,branch,main-aa,branch-v-noarity --rotation 0 --groups G3,G6,G7 --ids '^(?!.*data-first)' --sizes XS,S,C,x64,x1 --source dist --node-flags=--jitless --scale 1 --no-native --if-missing
# ~3.5 min, 82 entries
node scripts/run-bench.mjs --name noarity/jitless-r2 --copies main,branch,main-aa,branch-v-noarity --rotation 2 --groups G3,G6,G7 --ids '^(?!.*data-first)' --sizes XS,S,C,x64,x1 --source dist --node-flags=--jitless --scale 1 --no-native --if-missing
# ~3.5 min, 82 entries
node scripts/run-bench.mjs --name noarity/maxopt1-r0 --copies main,branch,main-aa,branch-v-noarity --rotation 0 --groups G3,G6,G7 --ids '^(?!.*data-first)' --sizes XS,S,C,x64,x1 --source dist --max-opt 1 --scale 1 --no-native --if-missing
# ~3.5 min, 82 entries
node scripts/run-bench.mjs --name noarity/maxopt1-r2 --copies main,branch,main-aa,branch-v-noarity --rotation 2 --groups G3,G6,G7 --ids '^(?!.*data-first)' --sizes XS,S,C,x64,x1 --source dist --max-opt 1 --scale 1 --no-native --if-missing

## Reports (no measurement): the aggregations, then the verdict
## (results/noarity/verdict.md)
# ~1 min
node scripts/aggregate.mjs --allow-empty --out results/noarity/agg-conf --title 'noarity confirmation (vs main; noarity vs branch in verdict.md)' --candidates branch,branch-v-noarity results/noarity/conf-r*.json && node scripts/aggregate.mjs --allow-empty --out results/noarity/agg-jitless --title 'noarity, --jitless' --candidates branch,branch-v-noarity results/noarity/jitless-r*.json && node scripts/aggregate.mjs --allow-empty --out results/noarity/agg-maxopt1 --title 'noarity, --max-opt=1' --candidates branch,branch-v-noarity results/noarity/maxopt1-r*.json && node scripts/noarity-verdict.mjs --dir results/noarity

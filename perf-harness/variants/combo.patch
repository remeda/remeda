@@ -0,0 +1,31 @@
+/**
+ * Calls `fn` with the elements of `args` as its arguments, the same as
+ * `fn(...args)`.
+ *
+ * Spreading an array whose length the compiler can't see goes through a
+ * generic builtin that copies it onto the stack on every call; the arities
+ * below cover almost every implementation called this way, and pass their
+ * arguments directly.
+ */
+export function callWithArguments<Return>(
+  fn: (...args: readonly unknown[]) => Return,
+  args: readonly unknown[],
+): Return {
+  switch (args.length) {
+    case 0:
+      return fn();
+
+    case 1:
+      return fn(args[0]);
+
+    case 2:
+      return fn(args[0], args[1]);
+
+    // eslint-disable-next-line @typescript-eslint/no-magic-numbers -- An argument count, spelled out by the call below it.
+    case 3:
+      return fn(args[0], args[1], args[2]);
+
+    default:
+      return fn(...args);
+  }
+}

{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowArbitraryExtensions": true,
    "plugins": [{ "name": "@astrojs/ts-plugin" }],
    "moduleDetection": "force",
    "lib": ["es2022", "dom", "dom.iterable"]
  }
}

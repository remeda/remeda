.PHONY: install e2e
install:
	cd ../.. && npm ci -w packages/remeda
e2e:
	npx vitest run --typecheck --reporter=dot

# ---- agentic-kit standards (generated by adopt-standards; edit .agentic/mk/*.mk, not this block) ----
include .agentic/mk/typescript.mk
.PHONY: lint test format audit all
lint: lint-ts
	@if command -v gitleaks >/dev/null 2>&1; then gitleaks detect --no-banner --redact; else echo "gitleaks not installed (brew install gitleaks / winget install gitleaks)"; fi
test: test-ts
format: format-ts
audit: audit-ts
all: lint audit test e2e
# ---- end agentic-kit ----
